# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.
### Variables
#
set $mod Mod1
set $super Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
set $menu ~/.config/rofi/scripts/launcher_t1

# Include dynamic pywal colors
include ~/.cache/wal/colors-sway

# Font
font pango:Inter 10

### Output configuration
#
# Default wallpaper
output * bg $wallpaper fill
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
# Lock after 10 mins (600s), turn off display after 15 mins (900s), lock before sleep
exec swayidle -w \
    timeout 600 'swaylock -f' \
    timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'

# Lock screen when closing laptop lid
bindswitch lid:on exec swaylock -f

### Input configuration
input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

# Smooth 3-finger workspace swipe gestures
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term
    bindsym $super+Return exec $term

    # Web browser
    bindsym $mod+w exec zen-browser
    bindsym $super+w exec zen-browser
    bindsym $mod+Ctrl+b exec zen-browser

    # File manager (Ranger floating TUI & Dolphin GUI)
    bindsym $mod+e exec kitty --app-id floating-fm -e ranger
    bindsym $super+e exec kitty --app-id floating-fm -e ranger
    bindsym $mod+Shift+e exec kitty --app-id floating-fm -e ranger
    bindsym $super+Shift+e exec kitty --app-id floating-fm -e ranger
    bindsym $mod+Shift+d exec dolphin
    bindsym $super+Shift+d exec dolphin

    # Kill focused window (Vim :q style)
    bindsym $mod+q kill
    bindsym $super+q kill

    # Start your launcher
    bindsym $mod+Space exec $menu
    bindsym $super+Space exec $menu
    
    # Keybindings Cheat-Sheet HUD & Help Page
    bindsym $mod+slash exec ~/.local/bin/keybinds-menu
    bindsym $super+slash exec ~/.local/bin/keybinds-menu
    bindsym $mod+question exec ~/.local/bin/keybinds-menu
    bindsym $super+question exec ~/.local/bin/keybinds-menu
    bindsym F1 exec ~/.local/bin/keybinds-menu
    bindsym $mod+F1 exec ~/.local/bin/keybinds-menu
    bindsym $super+F1 exec ~/.local/bin/keybinds-menu

    # Full formatted help manual in Glow
    bindsym $mod+Shift+question exec kitty --app-id floating-help -e glow -p /home/wvrn/.dotfiles/KEYBINDS.md
    bindsym $super+Shift+question exec kitty --app-id floating-help -e glow -p /home/wvrn/.dotfiles/KEYBINDS.md
    bindsym $mod+Shift+slash exec kitty --app-id floating-help -e glow -p /home/wvrn/.dotfiles/KEYBINDS.md
    bindsym $super+Shift+slash exec kitty --app-id floating-help -e glow -p /home/wvrn/.dotfiles/KEYBINDS.md

    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+r reload
    bindsym $super+Shift+r reload

    # Exit sway session & power menu
    bindsym $mod+m exec ~/.local/bin/sway-exit-menu
    bindsym $super+m exec ~/.local/bin/sway-exit-menu

    # Direct system power shortcuts (Shutdown, Reboot, Lock)
    bindsym $mod+Shift+Delete exec systemctl poweroff
    bindsym $super+Shift+Delete exec systemctl poweroff
    bindsym $mod+Shift+BackSpace exec systemctl reboot
    bindsym $super+Shift+BackSpace exec systemctl reboot
    bindsym $mod+Shift+Escape exec swaylock
    bindsym $super+Shift+Escape exec swaylock
#
# Moving around:
#
    # Move your focus around (Vim keys)
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $super+$left focus left
    bindsym $super+$down focus down
    bindsym $super+$up focus up
    bindsym $super+$right focus right
    # Or use arrow keys
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right
    bindsym $super+Left focus left
    bindsym $super+Down focus down
    bindsym $super+Up focus up
    bindsym $super+Right focus right

    # Move the focused window (Vim keys)
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $super+Shift+$left move left
    bindsym $super+Shift+$down move down
    bindsym $super+Shift+$up move up
    bindsym $super+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
    bindsym $super+Shift+Left move left
    bindsym $super+Shift+Down move down
    bindsym $super+Shift+Up move up
    bindsym $super+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    bindsym $super+1 workspace number 1
    bindsym $super+2 workspace number 2
    bindsym $super+3 workspace number 3
    bindsym $super+4 workspace number 4
    bindsym $super+5 workspace number 5
    bindsym $super+6 workspace number 6
    bindsym $super+7 workspace number 7
    bindsym $super+8 workspace number 8
    bindsym $super+9 workspace number 9
    bindsym $super+0 workspace number 10

    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    bindsym $super+Shift+1 move container to workspace number 1
    bindsym $super+Shift+2 move container to workspace number 2
    bindsym $super+Shift+3 move container to workspace number 3
    bindsym $super+Shift+4 move container to workspace number 4
    bindsym $super+Shift+5 move container to workspace number 5
    bindsym $super+Shift+6 move container to workspace number 6
    bindsym $super+Shift+7 move container to workspace number 7
    bindsym $super+Shift+8 move container to workspace number 8
    bindsym $super+Shift+9 move container to workspace number 9
    bindsym $super+Shift+0 move container to workspace number 10

    # Workspace tab cycling (Vim style gt / gT)
    bindsym $mod+Tab workspace next
    bindsym $mod+Shift+Tab workspace prev
    bindsym $super+Tab workspace next
    bindsym $super+Shift+Tab workspace prev
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    gaps outer 0
    gaps inner 0
    hide_edge_borders both
    default_border pixel 0
    default_floating_border pixel 0
    for_window [app_id="^.*"] border pixel 0
    for_window [class="^.*"] border pixel 0
    for_window [app_id="tui-settings"] floating enable, resize set 800 520, move position center
    for_window [app_id="dropdown-term"] floating enable, resize set 900 520, move position center, move scratchpad
    for_window [app_id="floating-notes"] floating enable, resize set 850 560, move position center
    for_window [app_id="floating-finder"] floating enable, resize set 1000 620, move position center
    for_window [app_id="floating-fm"] floating enable, resize set 1000 620, move position center
    for_window [app_id="floating-help"] floating enable, resize set 1050 660, move position center
    for_window [app_id="tui-monitor"] floating enable, resize set 1000 620, move position center
    # Automatically route Apple Music in Zen to workspace 3
    for_window [app_id="zen" title=".*Apple.*Music.*"] move container to workspace number 3
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $super+b splith
    bindsym $mod+v splitv
    bindsym $super+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $super+s layout stacking
    bindsym $mod+Shift+t layout tabbed
    bindsym $super+Shift+t layout tabbed
    bindsym $mod+t layout toggle split
    bindsym $super+t layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen
    bindsym $super+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle
    bindsym $super+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+Ctrl+space focus mode_toggle
    bindsym $super+Ctrl+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
    bindsym $super+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad
    bindsym $super+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
    bindsym $super+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Shift for large adjustments (30px)
    bindsym Shift+$left resize shrink width 30px
    bindsym Shift+$down resize grow height 30px
    bindsym Shift+$up resize shrink height 30px
    bindsym Shift+$right resize grow width 30px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym q mode "default"
}
bindsym $mod+r mode "resize"
bindsym $super+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via PulseAudio
    bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
    bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

    # Media playback controls via playerctl (Apple Music / Zen, Spotify, etc.)
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioStop exec playerctl stop

    # Keyboard fallback bindings
    bindsym $mod+p exec playerctl play-pause
    bindsym $super+p exec playerctl play-pause
    bindsym $mod+bracketright exec playerctl next
    bindsym $super+bracketright exec playerctl next
    bindsym $mod+bracketleft exec playerctl previous
    bindsym $super+bracketleft exec playerctl previous
    # Special keys to adjust brightness via brightnessctl
    bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
    bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
    # Screenshots (fullscreen & interactive crop selection)
    bindsym Print exec ~/.local/bin/screenshot --full
    bindsym Shift+Print exec ~/.local/bin/screenshot --area
    bindsym $mod+Print exec ~/.local/bin/screenshot --area
    bindsym $super+Print exec ~/.local/bin/screenshot --area

    # Searchable clipboard history
    bindsym $mod+c exec ~/.local/bin/clipboard-menu
    bindsym $super+c exec ~/.local/bin/clipboard-menu

    # Instant dropdown scratchpad terminal
    bindsym $mod+grave exec ~/.local/bin/toggle-dropdown
    bindsym $super+grave exec ~/.local/bin/toggle-dropdown

    # Quick floating scratchpad notes
    bindsym $mod+n exec kitty --app-id floating-notes -e ~/.local/bin/quick-notes
    bindsym $super+n exec kitty --app-id floating-notes -e ~/.local/bin/quick-notes

    # Interactive fuzzy file & code finder
    bindsym $mod+Shift+f exec kitty --app-id floating-finder -e ~/.local/bin/finder
    bindsym $super+Shift+f exec kitty --app-id floating-finder -e ~/.local/bin/finder

    # System Monitor (bottom)
    bindsym $mod+Shift+m exec kitty --app-id tui-monitor -e btm
    bindsym $super+Shift+m exec kitty --app-id tui-monitor -e btm

    # Wallpaper & dynamic color switcher
    bindsym $mod+Shift+w exec ~/.local/bin/change-wallpaper --select
    bindsym $super+Shift+w exec ~/.local/bin/change-wallpaper --select
    bindsym $mod+Ctrl+w exec ~/.local/bin/change-wallpaper --random
    bindsym $super+Ctrl+w exec ~/.local/bin/change-wallpaper --random

    # Minimal Wi-Fi selector
    bindsym $mod+Shift+n exec ~/.local/bin/rofi-wifi-menu
    bindsym $super+Shift+n exec ~/.local/bin/rofi-wifi-menu

    # Minimal TUI System Settings
    bindsym $mod+comma exec kitty --app-id tui-settings -e ~/.local/bin/settings
    bindsym $super+comma exec kitty --app-id tui-settings -e ~/.local/bin/settings
    bindsym $mod+Shift+s exec kitty --app-id tui-settings -e ~/.local/bin/settings
    bindsym $super+Shift+s exec kitty --app-id tui-settings -e ~/.local/bin/settings

# Window colors (borderless)
# class                 border      bground     text        indicator   child_border
client.focused          $background $background $foreground $background $background
client.focused_inactive $background $background $foreground $background $background
client.unfocused        $background $background $foreground $background $background
client.urgent           $color1     $color1     $foreground $color1     $color1
client.placeholder      $background $background $foreground $background $background

# Restore wallpaper and colorscheme on startup
exec ~/.local/bin/change-wallpaper --restore

# Background services on login
exec ~/.local/bin/sway-startup

# Night Light / Blue light filter (gammastep)
exec which gammastep >/dev/null 2>&1 && gammastep

# Clipboard history watcher (if wl-clipboard and cliphist are installed)
exec which cliphist >/dev/null 2>&1 && wl-paste --watch cliphist store
exec which cliphist >/dev/null 2>&1 && wl-paste --type image --watch cliphist store

# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    id bar-0
    swaybar_command waybar
    position top
    mode dock
    hidden_state show
    modifier none
}

bindsym $mod+Shift+b exec killall -SIGUSR1 waybar
bindsym $super+Shift+b exec killall -SIGUSR1 waybar

include /etc/sway/config.d/*
