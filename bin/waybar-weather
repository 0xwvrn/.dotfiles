#!/usr/bin/env bash
# ~/.local/bin/waybar-weather: Lightweight cached weather module for Waybar

CACHE_FILE="/tmp/waybar_weather.cache"
MAX_AGE=1800 # 30 minutes

# Check if cache exists and is fresh
if [ -f "$CACHE_FILE" ]; then
    CURRENT_TIME=$(date +%s)
    FILE_TIME=$(stat -c %Y "$CACHE_FILE" 2>/dev/null || stat -f %m "$CACHE_FILE" 2>/dev/null || echo 0)
    AGE=$((CURRENT_TIME - FILE_TIME))
    if [ "$AGE" -lt "$MAX_AGE" ]; then
        cat "$CACHE_FILE"
        exit 0
    fi
fi

# Fetch weather with strict 2-second timeout
WEATHER=$(curl -s --max-time 2 "wttr.in/?format=%c+%t" 2>/dev/null | tr -d '\n' | sed 's/+//' || true)

if [ -n "$WEATHER" ] && [[ "$WEATHER" != *"Unknown"* ]] && [[ "$WEATHER" != *"502"* ]]; then
    echo "$WEATHER" > "$CACHE_FILE"
    echo "$WEATHER"
elif [ -f "$CACHE_FILE" ]; then
    cat "$CACHE_FILE"
else
    echo "󰖐"
fi
