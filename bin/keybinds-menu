#!/usr/bin/env bash
# ~/.local/bin/keybinds-menu: Searchable keybindings HUD for Sway & Neovim ecosystem

declare -A COMMANDS=(
    ["View Full Guide in Glow"]="kitty --app-id floating-help -e glow -p /home/wvrn/.dotfiles/KEYBINDS.md"
    ["Terminal (Kitty)"]="kitty"
    ["Application Launcher (Rofi)"]="$HOME/.config/rofi/scripts/launcher_t1"
    ["Zen Web Browser"]="zen-browser"
    ["File Manager (Ranger)"]="kitty --app-id floating-fm -e ranger"
    ["GUI File Manager (Dolphin)"]="dolphin"
    ["Close Focused Window"]="swaymsg kill"
    ["Fuzzy File Finder"]="finder"
    ["Control Center / Settings"]="settings"
    ["Clipboard History"]="clipboard-menu"
    ["Wi-Fi Network Menu"]="rofi-wifi-menu"
    ["Toggle Dropdown Terminal"]="toggle-dropdown"
    ["Quick Sticky Note"]="quick-notes"
    ["System Monitor (Bottom)"]="kitty --app-id tui-monitor -e btm"
    ["Select Wallpaper"]="change-wallpaper -s"
    ["Random Wallpaper"]="change-wallpaper -r"
    ["System Exit / Power Menu"]="sway-exit-menu"
    ["Lock Screen (Swaylock)"]="swaylock"
    ["Screenshot Full Screen"]="screenshot full"
    ["Screenshot Selected Area"]="screenshot area"
    ["Toggle Fullscreen"]="swaymsg fullscreen toggle"
    ["Toggle Floating Window"]="swaymsg floating toggle"
    ["Vertical Split"]="swaymsg splith"
    ["Horizontal Split"]="swaymsg splitv"
    ["Reload Sway Config"]="swaymsg reload"
)

ITEMS=(
    "󰋖  [HELP]      Super/Alt + Shift + ?        View Full Guide in Glow"
    "󰌌  [WINDOW]    Super/Alt + h / j / k / l    Focus Neighbor Window (Vim)"
    "󰌌  [WINDOW]    Super/Alt + Shift + hjkl     Move Window Direction"
    "󰌌  [WINDOW]    Super/Alt + q                Close Focused Window"
    "󰌌  [WINDOW]    Super/Alt + f                Toggle Fullscreen"
    "󰌌  [WINDOW]    Super/Alt + Shift + Space    Toggle Floating Window"
    "󰌌  [SPLIT]     Super/Alt + v                Vertical Split"
    "󰌌  [SPLIT]     Super/Alt + b                Horizontal Split"
    "󰌌  [LAYOUT]    Super/Alt + s / w / t        Stacking / Tabbed / Toggle"
    "󰌌  [WORKSPACE] Super/Alt + 1..9             Switch to Workspace"
    "󰌌  [WORKSPACE] Super/Alt + Shift + 1..9     Move Container to Workspace"
    "󰌌  [WORKSPACE] Super/Alt + Tab / S-Tab      Next / Previous Workspace"
    "󰌌  [LAUNCH]    Super/Alt + Return           Terminal (Kitty)"
    "󰌌  [LAUNCH]    Super/Alt + Space            Application Launcher (Rofi)"
    "󰌌  [LAUNCH]    Super/Alt + w                Zen Web Browser"
    "󰌌  [LAUNCH]    Super/Alt + e                File Manager (Ranger)"
    "󰌌  [LAUNCH]    Super/Alt + Shift + d        GUI File Manager (Dolphin)"
    "󰌌  [LAUNCH]    Super/Alt + Shift + f        Fuzzy File Finder"
    "󰌌  [LAUNCH]    Super/Alt + Shift + m        System Monitor (Bottom)"
    "󰌌  [LAUNCH]    Super/Alt + \` (grave)        Toggle Dropdown Terminal"
    "󰌌  [LAUNCH]    Super/Alt + n                Quick Sticky Note"
    "󰌌  [SYSTEM]    Super/Alt + c                Clipboard History"
    "󰌌  [SYSTEM]    Super/Alt + , (comma)        Control Center / Settings"
    "󰌌  [SYSTEM]    Super/Alt + Shift + n        Wi-Fi Network Menu"
    "󰌌  [SYSTEM]    Super/Alt + Shift + w        Select Wallpaper"
    "󰌌  [SYSTEM]    Super/Alt + Ctrl + w         Random Wallpaper"
    "󰌌  [SYSTEM]    Super/Alt + Shift + r        Reload Sway Config"
    "󰌌  [SYSTEM]    Super/Alt + m                System Exit / Power Menu"
    "󰌌  [SYSTEM]    Super/Alt + Shift + l        Lock Screen (Swaylock)"
    "󰌌  [MEDIA]     Super/Alt + p                Play / Pause Media"
    "󰌌  [MEDIA]     Super/Alt + ] / [            Next / Prev Track"
    "󰌌  [MEDIA]     Print / Super+Print          Screenshot Full Screen / Area"
    "󰌌  [VIM-TUI]   Kitty: Ctrl+Shift+h          Open Scrollback in Neovim"
    "󰌌  [VIM-TUI]   Rofi: Ctrl+j / Ctrl+k        Navigate Menus (Vim style)"
    "󰌌  [VIM-TUI]   MPV: z / Z / Ctrl+z          Subtitle Delay - / + / Reset"
)

selected=$(printf "%s\n" "${ITEMS[@]}" | rofi -dmenu -i -p "󰌌 Search Keybinds" -theme-str 'window {width: 60%;} listview {lines: 14;}')

if [ -n "$selected" ]; then
    action=$(echo "$selected" | sed -E 's/.*[ ]{2,}//')
    cmd="${COMMANDS[$action]}"
    if [ -n "$cmd" ]; then
        eval "$cmd &"
    fi
fi
