#!/usr/bin/env bash
# ~/.local/bin/keybinds-menu: Searchable keybindings HUD for Sway

declare -A COMMANDS=(
    ["Terminal (Kitty)"]="kitty"
    ["Application Launcher (Rofi)"]="$HOME/.config/rofi/scripts/launcher_t1"
    ["Zen Web Browser"]="zen-browser"
    ["File Manager (Dolphin)"]="dolphin"
    ["Close Focused Window"]="swaymsg kill"
    ["Select Wallpaper"]="change-wallpaper -s"
    ["Random Wallpaper"]="change-wallpaper -r"
    ["Control Center / Settings"]="settings"
    ["Clipboard History"]="clipboard-menu"
    ["File Finder"]="finder"
    ["Wi-Fi Network Menu"]="rofi-wifi-menu"
    ["Toggle Dropdown Terminal"]="toggle-dropdown"
    ["Quick Sticky Note (Nano)"]="quick-notes"
    ["System Exit / Power Menu"]="sway-exit-menu"
    ["Lock Screen (Swaylock)"]="swaylock"
    ["Screenshot Full Screen"]="screenshot full"
    ["Screenshot Selected Area"]="screenshot area"
    ["Toggle Fullscreen"]="swaymsg fullscreen toggle"
    ["Toggle Floating Window"]="swaymsg floating toggle"
    ["Split Horizontal"]="swaymsg split h"
    ["Split Vertical"]="swaymsg split v"
    ["Reload Sway Config"]="swaymsg reload"
)

ITEMS=(
    "󰌌  Super + Return           Terminal (Kitty)"
    "󰌌  Super + Space            Application Launcher (Rofi)"
    "󰌌  Super + w                Zen Web Browser"
    "󰌌  Super + e                File Manager (Dolphin)"
    "󰌌  Super + q                Close Focused Window"
    "󰌌  Super + Shift + w        Select Wallpaper"
    "󰌌  Super + Alt + w          Random Wallpaper"
    "󰌌  Super + Shift + p        Control Center / Settings"
    "󰌌  Super + Shift + v        Clipboard History"
    "󰌌  Super + Shift + f        File Finder"
    "󰌌  Super + Shift + n        Wi-Fi Network Menu"
    "󰌌  Super + u                Toggle Dropdown Terminal"
    "󰌌  Super + n                Quick Sticky Note (Nano)"
    "󰌌  Super + Shift + e        System Exit / Power Menu"
    "󰌌  Super + Shift + l        Lock Screen (Swaylock)"
    "󰌌  Print                    Screenshot Full Screen"
    "󰌌  Super + Print            Screenshot Selected Area"
    "󰌌  Super + /                Keybinds Cheat Sheet HUD"
    "󰌌  Super + f                Toggle Fullscreen"
    "󰌌  Super + Shift + Space    Toggle Floating Window"
    "󰌌  Super + b                Split Horizontal"
    "󰌌  Super + v                Split Vertical"
    "󰌌  Super + Shift + r        Reload Sway Config"
    "󰌌  Super + 1..9             Switch to Workspace 1-9"
    "󰌌  Super + Shift + 1..9     Move Window to Workspace 1-9"
    "󰌌  Super + Arrows / hjkl    Focus Neighbor Window"
)

selected=$(printf "%s\n" "${ITEMS[@]}" | rofi -dmenu -i -p "󰌌 Keybinds" -theme-str 'window {width: 48%;} listview {lines: 12;}')

if [ -n "$selected" ]; then
    # Extract action description
    action=$(echo "$selected" | sed -E 's/.*[ ]{2,}//')
    cmd="${COMMANDS[$action]}"
    if [ -n "$cmd" ]; then
        eval "$cmd &"
    fi
fi
