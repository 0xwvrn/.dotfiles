#!/usr/bin/env python3
"""
tui-music-player: Ultra-fast Vim-first Minimal Terminal Music Player powered by MPV IPC.

Features:
- Instant cached launch: directly displays clean track list in ~5 milliseconds.
- Clean header: 'Library - X tracks (total time)'. Zero clutter.
- j / k navigation: Always instantaneous and non-blocking during active playback.
- Space / Enter: Play selected track; Space toggles pause on active track.
- Dual Views (1 & 2):
    1: All Songs View (flat library list)
    2: Artist Specific View (left column: Artists, right column: Albums & Songs)
- Tab: Switch between Artist column and Track column in Artist View.
- s: Interactive Sort Menu (Title, Artist, Album, Duration, Recently Added).
- S: Single-tap Shuffle toggle.
- a: Artist Scope mode (limits playback to currently selected artist only).
- Non-blocking scratchpad toggle in Sway.
"""

import curses
import json
import os
import random
import socket
import subprocess
import sys
import time

MUSIC_DIR = os.path.expanduser("~/Music")
CACHE_FILE = os.path.expanduser("~/.cache/tui_music_cache.json")
SOCKET_PATH = f"/tmp/tui_music_player_{os.getuid()}.sock"
SUPPORTED_EXTS = {".flac", ".mp3", ".m4a", ".ogg", ".wav", ".opus", ".aac", ".wma"}

class MpvController:
    def __init__(self, sock_path):
        self.sock_path = sock_path
        self.proc = None
        self._ensure_server()

    def _ensure_server(self):
        if os.path.exists(self.sock_path):
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(0.2)
                s.connect(self.sock_path)
                s.sendall(b'{"command": ["get_property", "pause"]}\n')
                resp = s.recv(1024)
                s.close()
                if resp:
                    return
            except Exception:
                pass
            try:
                os.remove(self.sock_path)
            except OSError:
                pass

        self.proc = subprocess.Popen(
            [
                "mpv",
                "--idle",
                "--no-video",
                f"--input-ipc-server={self.sock_path}",
                "--volume=100",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        for _ in range(25):
            if os.path.exists(self.sock_path):
                break
            time.sleep(0.04)

    def send_cmd(self, command_list):
        if not os.path.exists(self.sock_path):
            self._ensure_server()
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(0.15)
            s.connect(self.sock_path)
            payload = json.dumps({"command": command_list}) + "\n"
            s.sendall(payload.encode("utf-8"))
            resp_raw = b""
            while True:
                chunk = s.recv(2048)
                if not chunk:
                    break
                resp_raw += chunk
                if b"\n" in chunk:
                    break
            s.close()
            if resp_raw:
                return json.loads(resp_raw.decode("utf-8", errors="ignore"))
        except Exception:
            pass
        return None

    def play(self, filepath):
        self.send_cmd(["loadfile", filepath, "replace"])
        self.send_cmd(["set_property", "pause", False])

    def toggle_pause(self):
        self.send_cmd(["cycle", "pause"])

    def stop(self):
        self.send_cmd(["stop"])

    def seek(self, seconds):
        self.send_cmd(["seek", seconds, "relative"])

    def adjust_volume(self, delta):
        vol = self.get_property("volume") or 100
        new_vol = max(0, min(100, int(vol + delta)))
        self.send_cmd(["set_property", "volume", new_vol])
        return new_vol

    def get_property(self, prop_name):
        res = self.send_cmd(["get_property", prop_name])
        if res and res.get("error") == "success":
            return res.get("data")
        return None

    def quit(self):
        try:
            self.send_cmd(["quit"])
        except Exception:
            pass
        if self.proc:
            try:
                self.proc.terminate()
            except Exception:
                pass


def scan_music_library(music_dir):
    tracks = []
    if not os.path.isdir(music_dir):
        return tracks

    cache = {}
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, 'r', encoding='utf-8') as cf:
                cache = json.load(cf)
        except Exception:
            pass

    cache_dirty = False
    for root, _, files in os.walk(music_dir):
        for f in sorted(files):
            ext = os.path.splitext(f)[1].lower()
            if ext in SUPPORTED_EXTS:
                full_path = os.path.join(root, f)
                rel_path = os.path.relpath(full_path, music_dir)
                try:
                    mtime = os.path.getmtime(full_path)
                except OSError:
                    mtime = 0

                cached = cache.get(full_path)
                if cached and cached.get('mtime') == mtime:
                    tracks.append(cached)
                    continue

                clean_name = os.path.splitext(f)[0]
                guessed_artist = "<Unknown>"
                guessed_title = clean_name
                if " - " in clean_name:
                    parts = clean_name.split(" - ", 1)
                    guessed_artist = parts[0].strip()
                    guessed_title = parts[1].strip()
                    if guessed_artist and guessed_artist[0].isdigit() and ". " in guessed_artist:
                        guessed_artist = guessed_artist.split(". ", 1)[1]

                t_entry = {
                    "path": full_path,
                    "rel_path": rel_path,
                    "filename": f,
                    "title": guessed_title,
                    "artist": guessed_artist,
                    "album": os.path.basename(root) if root != music_dir else "<Single>",
                    "duration": 0,
                    "mtime": mtime,
                }

                try:
                    cmd = ["ffprobe", "-v", "quiet", "-print_format", "json", "-show_format", full_path]
                    raw = subprocess.check_output(cmd, stderr=subprocess.DEVNULL)
                    d = json.loads(raw.decode("utf-8", errors="ignore")).get("format", {})
                    tags = d.get("tags", {})
                    title = tags.get("title") or tags.get("TITLE")
                    artist = tags.get("artist") or tags.get("ARTIST") or tags.get("album_artist") or tags.get("ALBUM_ARTIST")
                    album = tags.get("album") or tags.get("ALBUM")
                    duration = float(d.get("duration", 0))
                    if title: t_entry["title"] = title
                    if artist: t_entry["artist"] = artist
                    if album: t_entry["album"] = album
                    t_entry["duration"] = int(duration)
                except Exception:
                    pass

                cache[full_path] = t_entry
                cache_dirty = True
                tracks.append(t_entry)

    if cache_dirty:
        try:
            os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
            with open(CACHE_FILE, "w", encoding="utf-8") as cf:
                json.dump(cache, cf)
        except Exception:
            pass

    return tracks


def format_time(seconds):
    if not seconds or seconds < 0:
        return "00:00"
    m = int(seconds) // 60
    s = int(seconds) % 60
    return f"{m:02d}:{s:02d}"


def run_ui(stdscr):
    try:
        curses.curs_set(0)
    except Exception:
        pass
    try:
        curses.start_color()
        curses.use_default_colors()
    except Exception:
        pass
    stdscr.timeout(100)

    # Clean pywal theme pairs
    try:
        curses.init_pair(1, curses.COLOR_YELLOW, -1)   # Accent Gold/Copper (Header/Current track)
        curses.init_pair(2, curses.COLOR_WHITE, -1)    # Normal text
        curses.init_pair(3, curses.COLOR_BLACK, curses.COLOR_YELLOW)  # Cursor Highlight
        curses.init_pair(4, curses.COLOR_CYAN, -1)     # Secondary Accent
        curses.init_pair(5, curses.COLOR_MAGENTA, -1)  # Status bar
    except Exception:
        pass

    mpv = MpvController(SOCKET_PATH)
    tracks = scan_music_library(MUSIC_DIR)

    # Sorting
    sort_mode = "artist"  # artist, title, album, duration, newest
    def sort_tracks(t_list, mode):
        if mode == "title":
            return sorted(t_list, key=lambda x: x["title"].lower())
        elif mode == "artist":
            return sorted(t_list, key=lambda x: (x["artist"].lower(), x["album"].lower(), x["title"].lower()))
        elif mode == "album":
            return sorted(t_list, key=lambda x: (x["album"].lower(), x["title"].lower()))
        elif mode == "duration":
            return sorted(t_list, key=lambda x: -x["duration"])
        elif mode == "newest":
            return sorted(t_list, key=lambda x: -x["mtime"])
        return t_list

    tracks = sort_tracks(tracks, sort_mode)

    active_view = 1  # 1: All Songs, 2: Artist Specific
    artist_col_focus = True  # In View 2: True = left (Artists), False = right (Tracks)

    all_selected_idx = 0
    artist_selected_idx = 0
    artist_track_selected_idx = 0

    current_playing_path = None
    is_shuffle = False
    is_artist_scope = False

    in_sort_menu = False
    sort_menu_idx = 0
    sort_options = [
        ("Artist (A-Z)", "artist"),
        ("Song Title (A-Z)", "title"),
        ("Album", "album"),
        ("Duration (Longest)", "duration"),
        ("Recently Added", "newest"),
    ]

    while True:
        artist_map = {}
        for t in tracks:
            artist_map.setdefault(t["artist"], []).append(t)
        artist_list = sorted(artist_map.keys(), key=lambda a: a.lower())

        # Sync playback state
        pos = mpv.get_property("time-pos") or 0
        dur = mpv.get_property("duration") or 0
        is_paused = mpv.get_property("pause")
        vol = mpv.get_property("volume") or 100
        active_path = mpv.get_property("path")
        if active_path:
            current_playing_path = active_path

        # Auto-advance when song ends
        if current_playing_path and pos == 0 and dur == 0 and not is_paused:
            if is_artist_scope:
                cur_track_obj = next((t for t in tracks if t["path"] == current_playing_path), None)
                cand = artist_map.get(cur_track_obj["artist"], tracks) if cur_track_obj else tracks
            else:
                cand = tracks
            if cand:
                if is_shuffle:
                    next_t = random.choice(cand)
                else:
                    cur_idx = next((i for i, t in enumerate(cand) if t["path"] == current_playing_path), -1)
                    next_t = cand[(cur_idx + 1) % len(cand)]
                current_playing_path = next_t["path"]
                mpv.play(next_t["path"])

        # Render screen
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        total_time = sum(t["duration"] for t in tracks)

        # 1. Clean Top Header: "Library - X tracks (total time)"
        header_text = f"Library - {len(tracks)} tracks ({format_time(total_time)})"
        stdscr.addstr(0, 1, header_text, curses.color_pair(1) | curses.A_BOLD)

        # 2. View Rendering
        content_y = 2
        content_h = max(2, h - 5)

        if active_view == 1:
            # === VIEW 1: All Songs (Flat sorted list) ===
            scroll_offset = max(0, all_selected_idx - content_h + 1) if all_selected_idx >= content_h else 0
            for row in range(content_h):
                idx = scroll_offset + row
                if idx >= len(tracks):
                    break
                t = tracks[idx]
                is_selected = (idx == all_selected_idx)
                is_playing = (t["path"] == current_playing_path)

                dur_str = format_time(t["duration"])
                icon = "▶ " if (is_playing and not is_paused) else ("⏸ " if is_playing else "  ")
                name_max = max(10, w - len(dur_str) - 8)
                display_str = f" {icon}{t['artist'][:26].ljust(26)}  {t['title'][:name_max].ljust(name_max)} {dur_str} "

                y = content_y + row
                if is_selected:
                    stdscr.attron(curses.color_pair(3) | curses.A_BOLD)
                    stdscr.addstr(y, 0, display_str.ljust(w - 1)[:w - 1])
                    stdscr.attroff(curses.color_pair(3) | curses.A_BOLD)
                elif is_playing:
                    stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
                    stdscr.addstr(y, 0, display_str[:w - 1])
                    stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)
                else:
                    stdscr.addstr(y, 0, display_str[:w - 1])

        elif active_view == 2:
            # === VIEW 2: Artist Specific View ===
            col1_w = min(30, max(18, w // 3))
            col2_w = w - col1_w - 2

            artist_selected_idx = max(0, min(artist_selected_idx, len(artist_list) - 1)) if artist_list else 0
            selected_artist = artist_list[artist_selected_idx] if artist_list else ""
            artist_tracks = artist_map.get(selected_artist, [])

            for row in range(content_h):
                y = content_y + row
                stdscr.addstr(y, col1_w, "│", curses.A_DIM)

            # Left column: Artist list
            art_scroll = max(0, artist_selected_idx - content_h + 1) if artist_selected_idx >= content_h else 0
            for row in range(content_h):
                idx = art_scroll + row
                if idx >= len(artist_list):
                    break
                a_name = artist_list[idx]
                is_sel = (idx == artist_selected_idx and artist_col_focus)
                y = content_y + row
                display_art = f" {a_name[:col1_w - 2].ljust(col1_w - 2)}"
                if is_sel:
                    stdscr.attron(curses.color_pair(3) | curses.A_BOLD)
                    stdscr.addstr(y, 0, display_art)
                    stdscr.attroff(curses.color_pair(3) | curses.A_BOLD)
                elif idx == artist_selected_idx:
                    stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
                    stdscr.addstr(y, 0, display_art)
                    stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)
                else:
                    stdscr.addstr(y, 0, display_art)

            # Right column: Selected Artist's Tracks
            trk_scroll = max(0, artist_track_selected_idx - content_h + 1) if artist_track_selected_idx >= content_h else 0
            for row in range(content_h):
                idx = trk_scroll + row
                if idx >= len(artist_tracks):
                    break
                t = artist_tracks[idx]
                is_sel = (idx == artist_track_selected_idx and not artist_col_focus)
                is_playing = (t["path"] == current_playing_path)
                dur_str = format_time(t["duration"])
                icon = "▶ " if (is_playing and not is_paused) else ("⏸ " if is_playing else "  ")
                name_max = max(10, col2_w - len(dur_str) - 6)
                disp_trk = f" {icon}{t['title'][:name_max].ljust(name_max)} {dur_str} "

                y = content_y + row
                x = col1_w + 1
                if is_sel:
                    stdscr.attron(curses.color_pair(3) | curses.A_BOLD)
                    stdscr.addstr(y, x, disp_trk.ljust(col2_w)[:col2_w])
                    stdscr.attroff(curses.color_pair(3) | curses.A_BOLD)
                elif is_playing:
                    stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
                    stdscr.addstr(y, x, disp_trk[:col2_w])
                    stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)
                else:
                    stdscr.addstr(y, x, disp_trk[:col2_w])

        # 3. Bottom Status Bar (Active track, Volume, Modes)
        bot_y = h - 2
        active_t = next((t for t in tracks if t["path"] == current_playing_path), None)
        if active_t:
            tag = "⏸" if is_paused else "▶"
            t_info = f" {tag} {active_t['artist']} - {active_t['title']} ({format_time(pos)} / {format_time(dur if dur else active_t['duration'])})"
        else:
            t_info = " . 00:00"

        modes = []
        if is_shuffle:
            modes.append("S")
        if is_artist_scope:
            modes.append("A")
        mode_str = " ".join(modes)
        right_info = f"sorted ({sort_mode}) | {vol}%" + (f" | {mode_str}" if mode_str else "") + " "
        max_left_w = max(10, w - len(right_info) - 2)
        stdscr.addstr(bot_y, 0, t_info[:max_left_w].ljust(max_left_w) + right_info.rjust(w - max_left_w)[:w - max_left_w], curses.color_pair(1))

        # 4. Interactive Sort Popup (when 's' is pressed)
        if in_sort_menu:
            popup_w = min(42, w - 4)
            popup_h = len(sort_options) + 2
            popup_x = max(2, (w - popup_w) // 2)
            popup_y = max(1, (h - popup_h) // 2)

            for py in range(popup_h):
                stdscr.addstr(popup_y + py, popup_x, " " * popup_w, curses.color_pair(3))

            stdscr.addstr(popup_y, popup_x + 2, "── Choose Sorting ──", curses.color_pair(3) | curses.A_BOLD)
            for idx, (label, mode_code) in enumerate(sort_options):
                prefix = "▶ " if idx == sort_menu_idx else "  "
                line = f"{prefix}{label}".ljust(popup_w - 4)
                attr = curses.A_REVERSE | curses.A_BOLD if idx == sort_menu_idx else curses.A_NORMAL
                stdscr.addstr(popup_y + 1 + idx, popup_x + 2, line, curses.color_pair(3) | attr)

        stdscr.refresh()

        # Keyboard Input
        try:
            ch = stdscr.getch()
        except Exception:
            ch = -1

        if ch == -1:
            continue

        if in_sort_menu:
            if ch in (ord('j'), curses.KEY_DOWN):
                sort_menu_idx = (sort_menu_idx + 1) % len(sort_options)
            elif ch in (ord('k'), curses.KEY_UP):
                sort_menu_idx = (sort_menu_idx - 1) % len(sort_options)
            elif ch in (10, 13, ord(' ')):
                sort_mode = sort_options[sort_menu_idx][1]
                tracks = sort_tracks(tracks, sort_mode)
                all_selected_idx = 0
                in_sort_menu = False
            elif ch in (27, ord('q'), ord('s')):
                in_sort_menu = False
            continue

        # Normal view controls
        if ch in (ord('q'), ord('Q')):
            mpv.quit()
            break
        elif ch == ord('1'):
            active_view = 1
        elif ch == ord('2'):
            active_view = 2
        elif ch == ord('\t'):  # Tab switches columns in View 2
            if active_view == 2:
                artist_col_focus = not artist_col_focus
            else:
                active_view = 2
        elif ch in (ord('j'), curses.KEY_DOWN):
            if active_view == 1 and tracks:
                all_selected_idx = min(len(tracks) - 1, all_selected_idx + 1)
            elif active_view == 2:
                if artist_col_focus and artist_list:
                    artist_selected_idx = min(len(artist_list) - 1, artist_selected_idx + 1)
                    artist_track_selected_idx = 0
                elif not artist_col_focus and artist_tracks:
                    artist_track_selected_idx = min(len(artist_tracks) - 1, artist_track_selected_idx + 1)
        elif ch in (ord('k'), curses.KEY_UP):
            if active_view == 1 and tracks:
                all_selected_idx = max(0, all_selected_idx - 1)
            elif active_view == 2:
                if artist_col_focus and artist_list:
                    artist_selected_idx = max(0, artist_selected_idx - 1)
                    artist_track_selected_idx = 0
                elif not artist_col_focus and artist_tracks:
                    artist_track_selected_idx = max(0, artist_track_selected_idx - 1)
        elif ch in (10, 13, ord(' ')):  # Enter or Space
            target_track = None
            if active_view == 1 and tracks:
                target_track = tracks[all_selected_idx]
            elif active_view == 2:
                if not artist_col_focus and artist_tracks:
                    target_track = artist_tracks[artist_track_selected_idx]
                elif artist_col_focus and artist_tracks:
                    target_track = artist_tracks[0]

            if target_track:
                if ch == ord(' ') and target_track["path"] == current_playing_path:
                    mpv.toggle_pause()
                else:
                    current_playing_path = target_track["path"]
                    mpv.play(target_track["path"])
        elif ch in (ord('s'),):  # Press 's' to open interactive sort menu!
            in_sort_menu = True
        elif ch in (ord('S'),):  # Shift+s toggles shuffle
            is_shuffle = not is_shuffle
        elif ch in (ord('a'), ord('A')):  # Toggle artist scope
            is_artist_scope = not is_artist_scope
        elif ch in (ord('h'), curses.KEY_LEFT):
            mpv.seek(-5)
        elif ch in (ord('l'), curses.KEY_RIGHT):
            mpv.seek(5)
        elif ch in (ord('b'),):
            # Previous track
            if tracks:
                cur_i = next((i for i, t in enumerate(tracks) if t["path"] == current_playing_path), 0)
                new_t = tracks[(cur_i - 1) % len(tracks)]
                current_playing_path = new_t["path"]
                mpv.play(new_t["path"])
        elif ch in (ord('n'),):
            # Next track
            if tracks:
                cur_i = next((i for i, t in enumerate(tracks) if t["path"] == current_playing_path), 0)
                new_t = tracks[(cur_i + 1) % len(tracks)]
                current_playing_path = new_t["path"]
                mpv.play(new_t["path"])
        elif ch in (ord('+'), ord('=')):
            mpv.adjust_volume(5)
        elif ch in (ord('-'),):
            mpv.adjust_volume(-5)
        elif ch in (ord('r'), ord('R')):
            # Rescan directory
            tracks = sort_tracks(scan_music_library(MUSIC_DIR), sort_mode)
        elif ch == 27:  # Esc -> hide to scratchpad
            subprocess.run(["swaymsg", "[app_id=\"tui-music\"] move scratchpad"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    try:
        curses.wrapper(run_ui)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
