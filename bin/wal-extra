    background-color: var(--background-modifier-form-field) !important;
    color: var(--text-normal) !important;
    border: 1px solid var(--background-modifier-border) !important;
}}

input::placeholder,
textarea::placeholder {{
    color: var(--text-muted) !important;
}}
"""

    manifest_json = json.dumps({
        "name": "Pywal",
        "version": "1.0.0",
        "minAppVersion": "0.15.0",
        "author": "Antigravity"
    }, indent=2)

    for vid, vinfo in vaults.items():
        vpath = vinfo.get("path")
        if not vpath or not os.path.isdir(vpath):
            continue

        # 1. Update snippets/pywal.css
        snippets_dir = os.path.join(vpath, ".obsidian", "snippets")
        os.makedirs(snippets_dir, exist_ok=True)
        snippet_file = os.path.join(snippets_dir, "pywal.css")
        with open(snippet_file, "w", encoding="utf-8") as sf:
            sf.write(css_snippet)

        # 2. Update themes/Pywal
        theme_dir = os.path.join(vpath, ".obsidian", "themes", "Pywal")
        os.makedirs(theme_dir, exist_ok=True)
        with open(os.path.join(theme_dir, "manifest.json"), "w", encoding="utf-8") as mf:
            mf.write(manifest_json)
        with open(os.path.join(theme_dir, "theme.css"), "w", encoding="utf-8") as tf:
            tf.write(css_snippet)

        # 3. Update appearance.json
        app_json = os.path.join(vpath, ".obsidian", "appearance.json")
        app_data = {}
        if os.path.exists(app_json):
            try:
                with open(app_json, "r", encoding="utf-8") as af:
                    app_data = json.load(af)
            except Exception:
                app_data = {}

        app_data["accentColor"] = accent_bright
        app_data["interfaceFontFamily"] = "Inter"
        app_data["textFontFamily"] = "Inter"
        app_data["monospaceFontFamily"] = "JetBrainsMono Nerd Font"
        app_data["nativeMenus"] = False
        snippets = app_data.get("enabledCssSnippets", [])
        if "pywal" not in snippets:
            snippets.append("pywal")
        app_data["enabledCssSnippets"] = snippets

        with open(app_json, "w", encoding="utf-8") as af:
            json.dump(app_data, af, indent=2)

        # 4. Update app.json (nativeMenus: False for 0px themed HTML menus)
        main_app_json = os.path.join(vpath, ".obsidian", "app.json")
        main_cfg = {}
        if os.path.exists(main_app_json):
            try:
                with open(main_app_json, "r", encoding="utf-8") as mf:
                    main_cfg = json.load(mf)
            except Exception:
                main_cfg = {}
        main_cfg["nativeMenus"] = False
        with open(main_app_json, "w", encoding="utf-8") as mf:
            json.dump(main_cfg, mf, indent=2)

        print(f"Updated Obsidian vault theme: {vpath}")

def update_mpv(bg_hex, fg, accent, c):
    """Updates mpv.conf, osc.conf, and uosc.conf to match system/pywal colors."""
    mpv_dir = os.path.expanduser("~/.config/mpv")
    script_opts_dir = os.path.join(mpv_dir, "script-opts")
    os.makedirs(script_opts_dir, exist_ok=True)

    bg_raw = bg_hex.lstrip('#')
    fg_raw = fg.lstrip('#')
    acc_raw = accent.lstrip('#')

    # 1. Update uosc.conf
    uosc_conf = os.path.join(script_opts_dir, "uosc.conf")
    uosc_content = f"""# uosc configuration - Modern, minimalist UI
border_radius=0
timeline_style=bar
timeline_line_width=3
timeline_size=12
timeline_border=1
timeline_cache=yes
timeline_persistency=paused

progress=always
progress_size=3
progress_line_width=20

controls=menu,gap,subtitles,<has_many_audio>audio,<has_many_video>video,gap,space,prev,play-pause,next,space,gap,fullscreen
controls_size=24
controls_margin=8
controls_spacing=4
controls_persistency=paused

volume=right
volume_size=40
volume_border=1
volume_step=1
speed_step=0.1

top_bar=no-border
top_bar_size=38
top_bar_title=yes
top_bar_persistency=paused

menu_item_height=36
menu_min_width=260
menu_padding=4
menu_type_to_search=yes

font_scale=0.7
scale=1.1
scale_fullscreen=1.3
animation_duration=120
proximity_in=50
proximity_out=140

color=foreground={acc_raw},foreground_text={bg_raw},background={bg_raw},background_text={fg_raw},window_border={bg_raw},curtain={bg_raw},match={acc_raw}
"""
    with open(uosc_conf, "w", encoding="utf-8") as f:
        f.write(uosc_content)

    # 2. Update osc.conf (fallback)
    osc_conf = os.path.join(script_opts_dir, "osc.conf")
    content = f"""# MPV On-Screen Controller (OSC) Configuration
layout=bottombar
seekbarstyle=bar
seekbarhandlesize=0.8
seekrangestyle=line
seekrangeseparate=no
seekrangealpha=160
boxalpha=180
fadeduration=200
hidetimeout=1500
minmousemove=2
showwindowed=yes
showfullscreen=yes
idlescreen=no
timetotal=yes
tooltipborder=1
scalewindowed=1.3
scalefullscreen=1.2

background_color={bg_hex}
title_color={fg}
timecode_color={fg}
buttons_color={fg}
top_buttons_color={accent}
time_pos_color={bg_hex}
time_pos_outline_color={accent}
held_element_color={accent}
"""
    with open(osc_conf, "w", encoding="utf-8") as f:
        f.write(content)

    # 3. Update mpv.conf
    mpv_conf = os.path.join(mpv_dir, "mpv.conf")
    mpv_content = f"""# MPV Modern & Minimal Configuration with uosc
osc=no
osd-bar=no
border=no

hwdec=auto-safe
vo=gpu-next
gpu-context=wayland

keep-open=yes
autofit-larger=85%x85%
cursor-autohide=1000
cursor-autohide-fs-only=no

# Subtitles styling
sub-font="Inter"
sub-font-size=38
sub-color="{fg}"
sub-border-color="{bg_hex}"
sub-border-size=1.5
sub-shadow-offset=0
sub-auto=fuzzy

# Screenshots
screenshot-format=png
screenshot-high-bit-depth=yes
screenshot-directory=~/Pictures/Photos
screenshot-template="mpv-shot%04n"
"""
    with open(mpv_conf, "w", encoding="utf-8") as f:
        f.write(mpv_content)


def update_lazygit(bg_hex, fg, accent, c):
    """Updates lazygit configuration with Pywal colors and sharp block borders."""
    lazygit_dir = os.path.expanduser("~/.config/lazygit")
    os.makedirs(lazygit_dir, exist_ok=True)
    cfg_file = os.path.join(lazygit_dir, "config.yml")

    content = f"""# Lazygit configuration - Minimal, blocky & delta-integrated
gui:
  border: single
  nerdFontsVersion: "3"
  showIcons: true
  showFileIcons: true
  sidePanelWidth: 0.3333
  theme:
    activeBorderColor:
      - "{accent}"
      - bold
    inactiveBorderColor:
      - "{c['color1']}"
    searchingActiveBorderColor:
      - "{c['color6']}"
      - bold
    optionsTextColor:
      - "{c['color3']}"
    selectedLineBgColor:
      - "{c['color1']}"
    inactiveViewSelectedLineBgColor:
      - bold
    cherryPickedCommitFgColor:
      - "{accent}"
    cherryPickedCommitBgColor:
      - "{bg_hex}"
    markedBaseCommitFgColor:
      - "{accent}"
    markedBaseCommitBgColor:
      - "{c['color1']}"
    unstagedChangesColor:
      - red
    defaultFgColor:
      - "{fg}"

git:
  paging:
    colorArg: always
    pager: delta --dark --paging=never
"""
    with open(cfg_file, "w", encoding="utf-8") as f:
        f.write(content)


def update_gdu(bg_hex, fg, accent, c, on_accent, selection_bg, selection_fg):
    """Generates ~/.gdu.yaml with current Pywal colors and sharp styling."""
    cfg_file = os.path.expanduser("~/.gdu.yaml")
    content = f"""# Pywal dynamic theme for gdu (SSD/HDD disk usage analyzer)
style:
    header:
        hidden: false
        text-color: '{on_accent}'
        background-color: '{accent}'
    footer:
        text-color: '{on_accent}'
        background-color: '{accent}'
        number-color: '{on_accent}'
    selected-row:
        text-color: '{selection_fg}'
        background-color: '{selection_bg}'
    marked:
        text-color: '{on_accent}'
        background-color: '{c['color3']}'
    result-row:
        directory-color: '{accent}'
        number-color: '{c['color5']}'
    progress-modal:
        current-item-path-max-len: 0
        show-disk-progress-bar: true
    use-old-size-bar: false
    show-bar-percentage: true

mouse: true
archive-browsing: false
collapse-path: true
no-cross: true
ignore-dirs:
    - /proc
    - /dev
    - /sys
    - /run
    - /tmp
"""
    with open(cfg_file, "w", encoding="utf-8") as f:
        f.write(content)
    print(f"Updated gdu config: {cfg_file}")


def update_shells():
    """Ensures ~/.bashrc and ~/.zshrc source terminal sequences and fzf."""
    snippet = """
# Pywal terminal sequences & fzf theme
if [ -f ~/.cache/wal/sequences ]; then
    (cat ~/.cache/wal/sequences &)
fi
if [ -f ~/.cache/wal/colors-fzf.sh ]; then
    source ~/.cache/wal/colors-fzf.sh
fi
"""
    for rc in [os.path.expanduser("~/.bashrc"), os.path.expanduser("~/.zshrc")]:
        if os.path.exists(rc):
            with open(rc, "r", encoding="utf-8") as f:
                content = f.read()
            if "colors-fzf.sh" not in content:
                with open(rc, "a", encoding="utf-8") as f:
                    f.write(snippet)
                print(f"Added pywal sequences & fzf hook to {rc}")

def main():
    if not os.path.exists(COLORS_JSON):
        print("Colors file not found. Run wal first.")
        return

    with open(COLORS_JSON, "r", encoding="utf-8") as f:
        wal = json.load(f)

    wallpaper = wal.get("wallpaper", "")
    if not wallpaper and os.path.exists(WAL_FILE):
        with open(WAL_FILE, "r") as wf:
            wallpaper = wf.read().strip()

    c = wal["colors"]
    bg_hex = wal["special"]["background"]
    fg_hex = wal["special"]["foreground"]

    is_dark = get_lum(bg_hex) < 128
    if is_dark:
        fg = ensure_light_hex(fg_hex, min_lum=238)
        bg_dark = darken(bg_hex, 0.75)
        hover_bg = lighten(bg_hex, 1.30)
    else:
        fg = fg_hex
        bg_dark = darken(bg_hex, 0.90)
        hover_bg = darken(bg_hex, 0.80)

    accent = c["color4"]
    selection_bg = c["color1"]
    selection_fg = "#121212" if get_lum(selection_bg) >= 110 else "#ffffff"
    on_accent = "#121212" if get_lum(accent) >= 120 else "#ffffff"
    surface = lighten(bg_hex, 1.20) if is_dark else darken(bg_hex, 0.85)

    update_gtk(bg_hex, fg, accent, selection_bg, selection_fg, bg_dark, hover_bg)
    update_fzf(bg_hex, fg, c, bg_dark)
    update_tmux(bg_hex, fg, accent, c, bg_dark, on_accent, surface)
    if wallpaper:
        update_swaylock(wallpaper, bg_hex, fg, accent, c)
        update_sddm(wallpaper, bg_hex, fg, accent, c, bg_dark, on_accent)
    update_swaynag(bg_hex, fg, accent, c, bg_dark, is_dark)
    update_obsidian(bg_hex, fg, accent, c, bg_dark, is_dark)
    update_mpv(bg_hex, fg, accent, c)
    update_lazygit(bg_hex, fg, accent, c)
    update_gdu(bg_hex, fg, accent, c, on_accent, selection_bg, selection_fg)
    update_shells()

if __name__ == "__main__":
    main()
