#!/usr/bin/env python3
"""
wal-extra: Extends wallpaper-based theme synchronization to:
- GTK 3.0 & GTK 4.0 (gtk.css with sharp 0px borders)
- fzf (colors-fzf.sh for terminal fuzzy searching, wifi, and bt TUIs)
- tmux (colors-tmux.conf and hot-reloads tmux sessions)
- swaylock (config with matching wallpaper image & ring indicator colors)
- Obsidian (accent color and pywal.css snippet for active vaults)
- Shells (.bashrc, .zshrc terminal sequences and fzf setup)
"""

import json
import os
import glob
import shutil
import subprocess

COLORS_JSON = os.path.expanduser("~/.cache/wal/colors.json")
WAL_FILE = os.path.expanduser("~/.cache/wal/wal")

def hex_to_rgb_tuple(h):
    h = h.lstrip('#')
    return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))

def get_lum(h):
    r, g, b = hex_to_rgb_tuple(h)
    return 0.299 * r + 0.587 * g + 0.114 * b

def darken(hex_color, factor=0.85):
    r, g, b = hex_to_rgb_tuple(hex_color)
    r = max(0, min(255, int(r * factor)))
    g = max(0, min(255, int(g * factor)))
    b = max(0, min(255, int(b * factor)))
    return f"#{r:02x}{g:02x}{b:02x}"

def lighten(hex_color, factor=1.25):
    r, g, b = hex_to_rgb_tuple(hex_color)
    r = min(255, max(0, int(r * factor)))
    g = min(255, max(0, int(g * factor)))
    b = min(255, max(0, int(b * factor)))
    return f"#{r:02x}{g:02x}{b:02x}"

def blend_colors(hex1, hex2, ratio=0.5):
    """Blends hex1 towards hex2 by ratio (0 = all hex1, 1 = all hex2)."""
    r1, g1, b1 = hex_to_rgb_tuple(hex1)
    r2, g2, b2 = hex_to_rgb_tuple(hex2)
    r = int(r1 + (r2 - r1) * ratio)
    g = int(g1 + (g2 - g1) * ratio)
    b = int(b1 + (b2 - b1) * ratio)
    return f"#{min(255, max(0, r)):02x}{min(255, max(0, g)):02x}{min(255, max(0, b)):02x}"

def ensure_light_hex(hex_str, min_lum=235):
    r, g, b = hex_to_rgb_tuple(hex_str)
    lum = 0.299 * r + 0.587 * g + 0.114 * b
    if lum < min_lum:
        ratio = (min_lum - lum) / max(1.0, (255.0 - lum))
        r = int(r + (255 - r) * ratio)
        g = int(g + (255 - g) * ratio)
        b = int(b + (255 - b) * ratio)
    return f"#{min(255, r):02x}{min(255, g):02x}{min(255, b):02x}"

def update_gtk(bg, fg, accent, selection_bg, selection_fg, bg_dark, hover_bg):
    """Generates GTK 3 and GTK 4 css."""
    css = f"""/* Pywal dynamic theme for GTK 3 & 4 */
@define-color theme_bg_color {bg};
@define-color theme_fg_color {fg};
@define-color theme_base_color {bg};
@define-color theme_text_color {fg};
@define-color theme_selected_bg_color {selection_bg};
@define-color theme_selected_fg_color {selection_fg};
@define-color borders {accent};
@define-color headerbar_bg_color {bg_dark};
@define-color headerbar_fg_color {fg};
@define-color popover_bg_color {bg_dark};
@define-color popover_fg_color {fg};
@define-color view_bg_color {bg};
@define-color view_fg_color {fg};

/* Sharp rectangular aesthetic (0px border-radius) */
* {{
    border-radius: 0px;
    font-family: "Inter", sans-serif;
}}

window, dialog {{
    background-color: @theme_bg_color;
    color: @theme_fg_color;
}}

/* Context Menus, Popovers, Dropdowns (Strict 0px Corners & Palette Matching) */
window.popup,
window.background.popup,
.popup,
menu,
.menu,
.context-menu,
popover,
.popover,
popover.menu,
popover > contents,
popover.menu > contents,
.popover > contents,
.csd.popup {{
    background-color: @theme_bg_color;
    color: @theme_fg_color;
    border: 1px solid @borders;
    border-radius: 0px;
    box-shadow: none;
    padding: 3px 0px;
}}

menubar, .menubar {{
    background-color: @headerbar_bg_color;
    color: @headerbar_fg_color;
}}

menuitem,
.menuitem,
modelbutton,
.modelbutton {{
    background-color: transparent;
    color: @theme_fg_color;
    border-radius: 0px;
    padding: 5px 12px;
    min-height: 22px;
}}

menuitem:hover,
menuitem:selected,
modelbutton:hover,
modelbutton:selected {{
    background-color: @theme_selected_bg_color;
    color: @theme_selected_fg_color;
    border-radius: 0px;
}}

menuitem label,
modelbutton label {{
    color: inherit;
    font-family: "Inter", sans-serif;
}}

menuitem arrow,
modelbutton arrow {{
    color: inherit;
}}

separator,
separator.horizontal,
.menu-separator {{
    background-color: @borders;
    min-height: 1px;
    margin: 4px 0px;
}}
"""
    settings_ini = """[Settings]
gtk-theme-name = Adwaita-dark
gtk-application-prefer-dark-theme = 1
gtk-font-name = Inter 10
gtk-icon-theme-name = Adwaita
gtk-cursor-theme-name = Adwaita
gtk-cursor-theme-size = 24
gtk-xft-antialias = 1
gtk-xft-hinting = 1
gtk-xft-hintstyle = hintslight
gtk-xft-rgba = rgb
"""
    for gtk_dir in [os.path.expanduser("~/.config/gtk-3.0"), os.path.expanduser("~/.config/gtk-4.0")]:
        os.makedirs(gtk_dir, exist_ok=True)
        path = os.path.join(gtk_dir, "gtk.css")
        with open(path, "w", encoding="utf-8") as f:
            f.write(css)
        print(f"Updated GTK CSS: {path}")
        ini_path = os.path.join(gtk_dir, "settings.ini")
        with open(ini_path, "w", encoding="utf-8") as f:
            f.write(settings_ini)

def update_fzf(bg, fg, c, bg_dark):
    """Generates colors-fzf.sh with pywal palette."""
    fzf_sh = os.path.expanduser("~/.cache/wal/colors-fzf.sh")
    content = f"""# Pywal dynamic colors for fzf
export FZF_DEFAULT_OPTS="
  --color=bg+:{bg_dark},bg:{bg},spinner:{c['color5']},hl:{c['color2']}
  --color=fg:{fg},header:{c['color2']},info:{c['color4']},pointer:{c['color5']}
  --color=marker:{c['color5']},fg+:{fg},prompt:{c['color4']},hl+:{c['color2']}
  --color=border:{c['color4']}
"
"""
    with open(fzf_sh, "w", encoding="utf-8") as f:
        f.write(content)
    print(f"Updated fzf theme: {fzf_sh}")

def update_tmux(bg, fg, accent, c, bg_dark, on_accent, surface):
    """Generates colors-tmux.conf and hot-reloads running tmux sessions."""
    tmux_conf = os.path.expanduser("~/.cache/wal/colors-tmux.conf")
    content = f"""# Pywal dynamic colors for tmux (sharp, modern aesthetic)
set -g status on
set -g status-interval 2
set -g status-position bottom
set -g status-justify left

# Terminal colors (24-bit Truecolor)
set -g default-terminal "tmux-256color"
set -as terminal-features ",*:RGB"

# Bar background and text
set -g status-style "bg={bg_dark},fg={fg}"

# Status Left & Right
set -g status-left "#[bg={accent},fg={on_accent},bold]  #S  #[bg={bg_dark},fg={accent}] "
set -g status-left-length 30
set -g status-right "#[bg={surface},fg={fg}]  %H:%M  #[bg={accent},fg={on_accent},bold]  %d-%b  "
set -g status-right-length 50

# Windows
set -g window-status-separator ""
set -g window-status-format "#[fg={c['color8']},bg={bg_dark}]  #I: #W  "
set -g window-status-current-format "#[fg={on_accent},bg={accent},bold]  #I: #W  "

# Panes
set -g pane-border-style "fg={darken(bg, 0.70)}"
set -g pane-active-border-style "fg={accent}"

# Command / Message / Mode
set -g message-style "bg={accent},fg={on_accent},bold"
set -g message-command-style "bg={accent},fg={on_accent},bold"
set -g mode-style "bg={accent},fg={on_accent},bold"
"""
    with open(tmux_conf, "w", encoding="utf-8") as f:
        f.write(content)
    print(f"Updated tmux theme: {tmux_conf}")

    # Ensure ~/.config/tmux/tmux.conf sources it
    for user_tmux in [os.path.expanduser("~/.config/tmux/tmux.conf"), os.path.expanduser("~/.tmux.conf")]:
        if os.path.exists(user_tmux) and not os.path.islink(user_tmux):
            with open(user_tmux, "r", encoding="utf-8") as f:
                cfg_text = f.read()
            if "colors-tmux.conf" not in cfg_text:
                with open(user_tmux, "a", encoding="utf-8") as f:
                    f.write('\n# Dynamic Pywal theme (loads after TPM to ensure wallpaper colors take effect)\nif-shell "[ -f ~/.cache/wal/colors-tmux.conf ]" "source-file ~/.cache/wal/colors-tmux.conf"\n')
                print(f"Added colors-tmux.conf include to {user_tmux}")

    # Hot reload running tmux sessions if any server is running
    try:
        subprocess.run(["tmux", "source-file", tmux_conf], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except Exception:
        pass

def render_swaylock_battery_image(wallpaper_path, bg, fg, accent):
    """Renders wallpaper with sharp 0px rectangular battery badge in top right."""
    cap = ""
    stat = ""
    try:
        with open("/sys/class/power_supply/BAT0/capacity") as f:
            cap = f.read().strip() + "%"
        with open("/sys/class/power_supply/BAT0/status") as f:
            s = f.read().strip()
            if s == "Charging":
                stat = " ⚡"
    except Exception:
        pass

    if not cap:
        return wallpaper_path

    out_path = "/tmp/swaylock-battery.png"
    font_path = os.path.expanduser("~/.local/share/fonts/Inter/Inter-Bold.ttf")
    if not os.path.exists(font_path):
        font_path = os.path.expanduser("~/.local/share/fonts/JetBrains-Mono-Nerd-Font-Complete.ttf")

    text = f"{cap}{stat}"
    cmd = [
        "magick", wallpaper_path,
        "-gravity", "NorthEast",
        "-fill", bg, "-stroke", accent, "-strokewidth", "1",
        "-draw", "rectangle 40,40 170,74",
        "-fill", fg, "-stroke", "none",
        "-font", font_path, "-pointsize", "14",
        "-draw", f"text 65,48 \"{text}\"",
        out_path
    ]
    try:
        subprocess.run(cmd, check=True, stderr=subprocess.DEVNULL)
        return out_path
    except Exception:
        return wallpaper_path

def update_swaylock(wallpaper_path, bg, fg, accent, c):
    """Generates ~/.config/swaylock/config matching current wallpaper."""
    swaylock_dir = os.path.expanduser("~/.config/swaylock")
    os.makedirs(swaylock_dir, exist_ok=True)
    cfg_file = os.path.join(swaylock_dir, "config")

    # Also ensure ~/.swaylock links to ~/.config/swaylock for full compatibility
    legacy_dir = os.path.expanduser("~/.swaylock")
    if not os.path.exists(legacy_dir):
        try:
            os.symlink(swaylock_dir, legacy_dir)
        except Exception:
            pass

    lock_img = render_swaylock_battery_image(wallpaper_path, bg, fg, accent)

    bg_clean = bg.lstrip('#')
    fg_clean = fg.lstrip('#')
    accent_clean = accent.lstrip('#')
    c1 = c['color1'].lstrip('#')
    c2 = c['color2'].lstrip('#')
    c4 = c['color4'].lstrip('#')
    c5 = c['color5'].lstrip('#')

    content = f"""# Pywal dynamic configuration for swaylock
image={lock_img}
color={bg_clean}
scaling=fill
daemonize
indicator-idle-visible
show-failed-attempts
ignore-empty-password
font="Noto Sans"

indicator-radius=100
indicator-thickness=7

inside-color={bg_clean}cc
inside-clear-color={bg_clean}cc
inside-ver-color={bg_clean}cc
inside-wrong-color={c1}cc

ring-color={accent_clean}
ring-clear-color={c2}
ring-ver-color={c4}
ring-wrong-color={c1}

key-hl-color={c5}
bs-hl-color={c1}

text-color={fg_clean}
text-clear-color={fg_clean}
text-ver-color={fg_clean}
text-wrong-color={fg_clean}

line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

separator-color=00000000
"""
    with open(cfg_file, "w", encoding="utf-8") as f:
        f.write(content)
    print(f"Updated swaylock theme: {cfg_file}")

def update_sddm(wallpaper_path, bg, fg, accent, c, bg_dark, on_accent):
    """Generates SDDM theme config & copies wallpaper if theme is writable."""
    theme_dir = "/usr/share/sddm/themes/sddm-gruvbox"
    if not os.path.isdir(theme_dir) or not os.access(theme_dir, os.W_OK):
        return

    ext = os.path.splitext(wallpaper_path)[1] or ".jpg"
    dest_bg = os.path.join(theme_dir, f"background{ext}")
    try:
        shutil.copyfile(wallpaper_path, dest_bg)
        os.chmod(dest_bg, 0o644)
    except Exception as e:
        print(f"Warning: could not copy wallpaper to SDDM theme: {e}")
        dest_bg = ""

    bg_name = f"background{ext}" if dest_bg else ""
    cfg_file = os.path.join(theme_dir, "theme.conf")

    content = f"""[General]
Font="Noto Sans"
FontSize=10
Background="{bg_name}"
PasswordShowLastLetter=1000

# [Colors]
hower     = "{accent}"
text      = "{fg}"
surface2  = "{c['color5']}"
surface1  = "{c['color8']}"
surface0  = "{bg_dark}"
overlay   = "{c['color1']}"
border    = "{accent}"
base      = "{bg}"
Primary   = "{accent}"
onPrimary = "{on_accent}"

## [Locale Settings]
Locale=""
HourFormat="hh:mm A"
DateFormat = "ddd dd/MM/yy"
"""
    try:
        with open(cfg_file, "w", encoding="utf-8") as f:
            f.write(content)
        print(f"Updated SDDM theme: {cfg_file}")
    except Exception as e:
        print(f"Warning: could not update SDDM theme: {e}")

def update_swaynag(bg, fg, accent, c, bg_dark, is_dark):
    """Generates ~/.config/swaynag/config matching wallpaper palette."""
    cfg_dir = os.path.expanduser("~/.config/swaynag")
    os.makedirs(cfg_dir, exist_ok=True)
    cfg_path = os.path.join(cfg_dir, "config")

    bg_raw = bg.lstrip('#')
    fg_raw = fg.lstrip('#')
    accent_raw = accent.lstrip('#')
    border_raw = blend_colors(bg, fg, 0.22).lstrip('#')
    btn_bg_raw = blend_colors(bg, fg, 0.12).lstrip('#')
    bar_bg_raw = blend_colors(bg, fg, 0.07).lstrip('#')
    accent_line_raw = c['color6'].lstrip('#') if is_dark else accent_raw

    content = f"""# Dynamic Pywal theme for swaynag
font=JetBrainsMono Nerd Font 10
edge=bottom
layer=overlay
message-padding=8
button-padding=6
button-gap=8
button-dismiss-gap=12
button-margin-right=15
button-border-size=1
border-bottom-size=2

background={bar_bg_raw}
border={border_raw}
border-bottom={accent_line_raw}
button-background={btn_bg_raw}
button-text={fg_raw}
text={fg_raw}

[warning]
background={bar_bg_raw}
border={border_raw}
border-bottom={accent_line_raw}
button-background={btn_bg_raw}
button-text={fg_raw}
text={fg_raw}

[error]
background={bar_bg_raw}
border=e06c75
border-bottom=e06c75
button-background={btn_bg_raw}
button-text={fg_raw}
text={fg_raw}
"""
    with open(cfg_path, "w", encoding="utf-8") as f:
        f.write(content)
    print(f"Updated swaynag theme: {cfg_path}")

def update_obsidian(bg, fg, accent, c, bg_dark, is_dark):
    """Updates Obsidian vaults with high-contrast pywal accent, full theme, and CSS snippet."""
    obsidian_json = os.path.expanduser("~/.config/obsidian/obsidian.json")
    if not os.path.exists(obsidian_json):
        return

    try:
        with open(obsidian_json, "r", encoding="utf-8") as f:
            data = json.load(f)
        vaults = data.get("vaults", {})
    except Exception:
        return

    if is_dark:
        bg_dark = blend_colors(bg, fg, 0.05)
        bg_darker = blend_colors(bg, "#000000", 0.40)
        bg_subtle = blend_colors(bg, fg, 0.08)
        hover_bg = blend_colors(bg, fg, 0.12)
        border_color = blend_colors(bg, fg, 0.18)
        fg_normal = ensure_light_hex(fg, min_lum=215)
        fg_muted = ensure_light_hex(c['color8'], min_lum=140)
        fg_faint = ensure_light_hex(c['color8'], min_lum=110)
        icon_col = ensure_light_hex(c['color7'], min_lum=190)
        icon_hover = "#ffffff"
        accent_bright = ensure_light_hex(accent, min_lum=135)
        h1 = ensure_light_hex(c['color1'], min_lum=135)
        h2 = ensure_light_hex(c['color2'], min_lum=140)
        h3 = ensure_light_hex(c['color3'], min_lum=140)
        h4 = ensure_light_hex(c['color4'], min_lum=140)
        h5 = ensure_light_hex(c['color5'], min_lum=145)
        h6 = ensure_light_hex(c['color6'], min_lum=140)
        code_fg = ensure_light_hex(c['color5'], min_lum=150)
        link_fg = ensure_light_hex(c['color4'], min_lum=140)
        tag_fg = ensure_light_hex(c['color2'], min_lum=140)
    else:
        bg_dark = blend_colors(bg, "#000000", 0.05)
        bg_darker = blend_colors(bg, "#000000", 0.10)
        bg_subtle = blend_colors(bg, "#000000", 0.08)
        hover_bg = blend_colors(bg, "#000000", 0.12)
        border_color = blend_colors(bg, "#000000", 0.18)
        fg_normal = fg
        fg_muted = c['color8']
        fg_faint = c['color8']
        icon_col = fg
        icon_hover = "#121212"
        accent_bright = accent
        h1 = c['color1']
        h2 = c['color2']
        h3 = c['color3']
        h4 = c['color4']
        h5 = c['color5']
        h6 = c['color6']
        code_fg = c['color5']
        link_fg = c['color4']
        tag_fg = c['color2']

    r, g, b = hex_to_rgb_tuple(accent_bright)

    css_snippet = f"""/* Pywal dynamic theme for Obsidian */
body, body.theme-dark, body.theme-light, :root, .theme-dark, .theme-light {{
    /* Standard Palette Variables */
    --color-red: {ensure_light_hex(c['color1'], min_lum=135)} !important;
    --color-orange: {ensure_light_hex(c['color3'], min_lum=140)} !important;
    --color-yellow: {ensure_light_hex(c['color5'], min_lum=145)} !important;
    --color-green: {ensure_light_hex(c['color2'], min_lum=140)} !important;
    --color-cyan: {ensure_light_hex(c['color6'], min_lum=140)} !important;
    --color-blue: {ensure_light_hex(c['color4'], min_lum=140)} !important;
    --color-purple: {ensure_light_hex(c['color1'], min_lum=135)} !important;
    --color-pink: {ensure_light_hex(c['color6'], min_lum=140)} !important;

    /* Base Color Palette */
    --color-base-00: {bg} !important;
    --color-base-10: {bg_dark} !important;
    --color-base-20: {bg_dark} !important;
    --color-base-25: {bg_darker} !important;
    --color-base-30: {border_color} !important;
    --color-base-35: {accent_bright} !important;
    --color-base-40: {accent_bright} !important;
    --color-base-50: {fg_muted} !important;
    --color-base-60: {fg_normal} !important;
    --color-base-70: {fg_normal} !important;
    --color-base-100: #ffffff !important;

    /* Backgrounds */
    --background-primary: {bg} !important;
    --background-primary-alt: {bg_dark} !important;
    --background-secondary: {bg_dark} !important;
    --background-secondary-alt: {bg_darker} !important;
    --background-modifier-border: {border_color} !important;
    --background-modifier-border-hover: {accent_bright} !important;
    --background-modifier-border-focus: {accent_bright} !important;
    --background-modifier-form-field: {bg_darker} !important;
    --background-accent: {accent_bright} !important;

    /* Accent & Brand */
    --color-accent: {accent_bright} !important;
    --color-accent-1: {darken(accent_bright, 0.85)} !important;
    --color-accent-2: {lighten(accent_bright, 1.15)} !important;
    --interactive-accent: {accent_bright} !important;
    --interactive-accent-hover: {lighten(accent_bright, 1.15)} !important;
    --interactive-accent-rgb: {r}, {g}, {b} !important;

    /* Text & Headings */
    --text-normal: {fg_normal} !important;
    --text-muted: {fg_muted} !important;
    --text-faint: {fg_faint} !important;
    --text-accent: {accent_bright} !important;
    --text-accent-hover: {lighten(accent_bright, 1.15)} !important;
    --bold-color: {fg_normal} !important;
    --italic-color: {fg_normal} !important;
    --inline-title-color: {fg_normal} !important;

    /* Distinct Palette Headings */
    --h1-color: {h1} !important;
    --h2-color: {h2} !important;
    --h3-color: {h3} !important;
    --h4-color: {h4} !important;
    --h5-color: {h5} !important;
    --h6-color: {h6} !important;

    /* Icons */
    --icon-color: {icon_col} !important;
    --icon-color-hover: {icon_hover} !important;
    --icon-color-active: {accent_bright} !important;
    --icon-color-focused: {accent_bright} !important;
    --clickable-icon: {icon_col} !important;
    --ribbon-icon-color: {icon_col} !important;
    --ribbon-icon-color-hover: {icon_hover} !important;
    --ribbon-icon-color-active: {accent_bright} !important;
    --nav-collapse-icon-color: {icon_col} !important;
    --tab-icon-color: {icon_col} !important;

    /* Navigation / File Tree */
    --nav-item-color: {fg_normal} !important;
    --nav-item-color-hover: #ffffff !important;
    --nav-item-color-active: {accent_bright} !important;
    --nav-item-color-selected: #ffffff !important;
    --nav-item-background-hover: {hover_bg} !important;
    --nav-item-background-active: {bg_subtle} !important;

    /* Tabs */
    --tab-text-color: {fg_muted} !important;
    --tab-text-color-active: #ffffff !important;
    --tab-text-color-focused: #ffffff !important;
    --tab-text-color-focused-active: {accent_bright} !important;
    --tab-background-active: {bg} !important;

    /* Code Blocks & Links */
    --code-normal: {code_fg} !important;
    --code-background: {bg_darker} !important;
    --link-color: {link_fg} !important;
    --link-color-hover: {lighten(link_fg, 1.15)} !important;
    --link-external-color: {link_fg} !important;
    --tag-color: {tag_fg} !important;
