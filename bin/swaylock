#!/usr/bin/env bash
# Swaylock wrapper: instant launch with pre-rendered lockscreen image

# Prevent duplicate swaylock spawns if lid and sleep triggers fire together
if pgrep -x swaylock >/dev/null 2>&1; then
    exit 0
fi

LOCK_IMG="/tmp/swaylock-battery.png"

# Ensure image exists (generates synchronously only if missing on fresh boot)
if [ ! -f "$LOCK_IMG" ]; then
    if [ -x "$HOME/.local/bin/generate-swaylock-bg" ]; then
        "$HOME/.local/bin/generate-swaylock-bg" --force
    fi
fi

# Queue asynchronous background refresh so future locks remain up-to-date
if [ -x "$HOME/.local/bin/generate-swaylock-bg" ]; then
    "$HOME/.local/bin/generate-swaylock-bg" >/dev/null 2>&1 &
fi

if [ -f "$LOCK_IMG" ]; then
    exec /usr/bin/swaylock -i "$LOCK_IMG" "$@"
else
    exec /usr/bin/swaylock "$@"
fi
