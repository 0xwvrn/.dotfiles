#!/usr/bin/env python3
# ~/.local/bin/toggle-music: Toggle instant floating Termusic scratchpad in Sway

import json
import os
import subprocess
import sys
import time

APP_ID = "tui-music"

def get_node():
    try:
        raw = subprocess.check_output(["swaymsg", "-t", "get_tree"], stderr=subprocess.DEVNULL)
        tree = json.loads(raw)
    except Exception:
        return None
    node = None
    def walk(n):
        nonlocal node
        if n.get("app_id") == APP_ID:
            node = n
            return
        for k in ("nodes", "floating_nodes"):
            for c in n.get(k, []):
                walk(c)
    walk(tree)
    return node

node = get_node()

if not node:
    # Ensure playlist.log is seeded with library tracks if empty
    playlist_log = os.path.expanduser("~/.config/termusic/playlist.log")
    if not os.path.exists(playlist_log) or os.path.getsize(playlist_log) == 0:
        music_dir = os.path.expanduser("~/Music")
        tracks = []
        for root, _, files in os.walk(music_dir):
            for f in files:
                if f.lower().endswith(('.mp3', '.m4a', '.flac', '.wav', '.ogg', '.opus')):
                    tracks.append(os.path.join(root, f))
        tracks.sort()
        if tracks:
            os.makedirs(os.path.dirname(playlist_log), exist_ok=True)
            with open(playlist_log, "w", encoding="utf-8") as fp:
                fp.write("0\n" + "\n".join(tracks) + "\n")

    # Spawn termusic in centered floating card with 8px padding
    subprocess.Popen([
        "kitty",
        f"--app-id={APP_ID}",
        "-o", "window_padding_width=8",
        "-o", "remember_window_size=no",
        "-o", "initial_window_width=920",
        "-o", "initial_window_height=540",
        "-e", "termusic", "--disable-cover", "/home/wvrn/Music"
    ])
    for _ in range(25):
        time.sleep(0.04)
        res = subprocess.run(
            ["swaymsg", f'[app_id="{APP_ID}"] scratchpad show, resize set 920 540, move position center, border pixel 2'],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        if res.returncode == 0:
            break
elif node.get("visible") and node.get("focused"):
    # Currently on screen and focused: hide it into scratchpad
    subprocess.run(["swaymsg", f'[app_id="{APP_ID}"] move scratchpad'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
else:
    # In scratchpad or unfocused: bring to front, focus, ensure centered geometry
    subprocess.run(["swaymsg", f'[app_id="{APP_ID}"] scratchpad show, resize set 920 540, move position center, focus'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
