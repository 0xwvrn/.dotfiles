#!/usr/bin/env bash
# ~/.local/bin/toggle-music: Toggle instant floating cmus player scratchpad in Sway

if ! swaymsg '[app_id="tui-music"] scratchpad show' >/dev/null 2>&1; then
    kitty --app-id tui-music -e cmus &
    sleep 0.18
    swaymsg '[app_id="tui-music"] scratchpad show' >/dev/null 2>&1 || true
fi
