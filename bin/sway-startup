#!/usr/bin/env bash
# ~/.local/bin/sway-startup: Background services on Sway login

set -e

# Pre-warm lockscreen background & run lightweight periodic battery refresh for instant locking
if [ -x "$HOME/.local/bin/generate-swaylock-bg" ]; then
    "$HOME/.local/bin/generate-swaylock-bg" &
    (while sleep 120; do "$HOME/.local/bin/generate-swaylock-bg"; done) &
fi
